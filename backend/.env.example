# ============================================
# AI Trading System - Backend Environment
# ============================================

# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_trading?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Python AI Service
AI_SERVICE_URL=http://localhost:8000

# Binance — public market data only, no key needed (backend never reads
# BINANCE_API_KEY/BINANCE_SECRET_KEY; that's an ai-service concern, see
# ai-service/.env.example, not this file)
BINANCE_BASE_URL=https://api.binance.com
# Optional override for the live-price WebSocket stream (binanceService.js
# already picks .us vs .com based on locale; only set this to force a
# specific endpoint)
BINANCE_WS_URL=

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=your_telegram_channel_id
TELEGRAM_BOT_USERNAME=YourBotUsername
# Secret configured on Telegram's side via setWebhook's `secret_token` param;
# the webhook checks X-Telegram-Bot-Api-Secret-Token against this value.
# Generate with e.g. `openssl rand -hex 32`. Leave unset locally if you're
# not testing the Telegram webhook.
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret

# Optional — used by hourlyReportJob.js to generate a natural-language
# summary; the job degrades gracefully (skips the AI summary) if unset.
OPENAI_API_KEY=

# AI worker tuning (optional — all have safe code-level fallbacks if unset;
# values below match those fallbacks as of 2026-08-18, see aiWorkerService.js)
AI_CONFIDENCE_THRESHOLD=70
AI_MIN_FUSED_SCORE=65
AI_MIN_QUALITY_SCORE=75
AI_MAX_OPEN_TRADES=5
AI_MAX_NEW_PER_CYCLE=3
AI_MAX_DAILY_LOSS_PCT=0.05

# Signal Config
SIGNAL_CONFIDENCE_THRESHOLD=70
MAX_SIGNALS_PER_HOUR=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS — explicit allowlist. Local dev origins only; production uses its
# own separate allowlist (see backend/.env.railway) — do not use `*` in
# production. Flutter mobile does not send an Origin header and is
# unaffected by this setting either way.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
