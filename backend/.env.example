# ============================================
# AI Trading System - Backend Environment
# ============================================

# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_trading?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Python AI Service
AI_SERVICE_URL=http://localhost:8000

# Binance API
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_BASE_URL=https://api.binance.com

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=your_telegram_channel_id
TELEGRAM_BOT_USERNAME=YourBotUsername
# Secret configured on Telegram's side via setWebhook's `secret_token` param;
# the webhook checks X-Telegram-Bot-Api-Secret-Token against this value.
# Generate with e.g. `openssl rand -hex 32`. Leave unset locally if you're
# not testing the Telegram webhook.
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret

# Twitter/X API
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Reddit API
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# Signal Config
SIGNAL_CONFIDENCE_THRESHOLD=70
MAX_SIGNALS_PER_HOUR=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS — explicit allowlist. Local dev origins only; production uses its
# own separate allowlist (see backend/.env.railway) — do not use `*` in
# production. Flutter mobile does not send an Origin header and is
# unaffected by this setting either way.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
