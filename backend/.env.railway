# ============================================================
# Railway Environment Variables — set these in Railway Dashboard
# ============================================================

NODE_ENV=production
PORT=5000
API_VERSION=v1

# MongoDB Atlas — required
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/ai-trading?retryWrites=true&w=majority

# JWT — generate a strong random secret (32+ chars)
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_EXPIRES_IN=30d

# Python AI Service — set to the Railway URL of your ai-service
AI_SERVICE_URL=https://YOUR_AI_SERVICE_URL.railway.app

# Binance (no key needed for public read-only data)
BINANCE_BASE_URL=https://api.binance.com
# Optional override for the live-price WebSocket stream (binanceService.js
# already picks .us vs .com based on locale; only set this to force a
# specific endpoint)
BINANCE_WS_URL=

# Optional — used by hourlyReportJob.js to generate a natural-language
# summary; the job degrades gracefully (skips the AI summary) if unset.
OPENAI_API_KEY=

# Firebase Cloud Messaging (optional — for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_BOT_USERNAME=
# Required if TELEGRAM_BOT_TOKEN is set — the secret configured on Telegram's
# side via setWebhook's `secret_token` param. The webhook verifies every
# incoming request's X-Telegram-Bot-Api-Secret-Token header against this
# value and rejects anything that doesn't match. Generate a strong random
# value (e.g. `openssl rand -hex 32`) — do not reuse the bot token itself.
TELEGRAM_WEBHOOK_SECRET=

# Alpha Vantage — free key for Gold/Oil/Forex data
# Get one at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# AI worker tuning (optional — all have safe code-level fallbacks if unset;
# values below match those fallbacks as of 2026-08-18, see aiWorkerService.js.
# Previous values here (60/10) predated the "Phase 18" tuning change and no
# longer matched the code's actual defaults — corrected during T-016.)
AI_CONFIDENCE_THRESHOLD=70
AI_MIN_FUSED_SCORE=65
AI_MIN_QUALITY_SCORE=75
AI_MAX_OPEN_TRADES=5
AI_MAX_NEW_PER_CYCLE=3
AI_MAX_DAILY_LOSS_PCT=0.05

# Signal engine
SIGNAL_CONFIDENCE_THRESHOLD=55
MAX_SIGNALS_PER_HOUR=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# CORS — explicit allowlist required in production (owner decision,
# 2026-08-18). Comma-separated exact origins, e.g.:
#   ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Leave EMPTY (as below) until a real production web origin exists — this
# denies all browser-based cross-origin requests, which is safe because
# there is no deployed web frontend for this app yet. The Flutter mobile
# app is unaffected either way: it sends no Origin header, so it's always
# allowed regardless of this list. Do NOT set this to `*` in production.
ALLOWED_ORIGINS=
